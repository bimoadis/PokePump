# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://pokepump:pokepump_secret@localhost:5432/pokepump?schema=public"

# Backend API Configuration
PORT=3001
API_BASE_URL="http://localhost:3001"
WEB_BASE_URL="http://localhost:3000"

# Twitter / X Webhook Integration
X_BOT_USERNAME="@getPokePump"
X_CONSUMER_KEY="your_x_consumer_key"
X_CONSUMER_SECRET="your_x_consumer_secret"
X_ACCESS_TOKEN="your_x_access_token"
X_ACCESS_TOKEN_SECRET="your_x_access_token_secret"
X_WEBHOOK_ENV="production"
X_WEBHOOK_SECRET="your_webhook_hmac_secret"

# Storage Configuration (Cloudflare R2 / AWS S3)
STORAGE_BUCKET="pokepump-assets"
STORAGE_ACCOUNT_ID="your_cloudflare_account_id"
STORAGE_ACCESS_KEY_ID="your_access_key"
STORAGE_SECRET_ACCESS_KEY="your_secret_key"
STORAGE_PUBLIC_URL="https://assets.pokepump.xyz"
